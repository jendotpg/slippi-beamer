[Unit]
Description=Check the network and the daemons that hand replays out
After=check-net.service lighttpd.service ssh.service

OnFailure=beamer-led-error.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/health-check.sh

Nice=19
CPUSchedulingPolicy=idle
IOSchedulingClass=idle
CPUWeight=1
IOWeight=1

[Install]
WantedBy=multi-user.target
