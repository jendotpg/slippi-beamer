[Unit]
Description=Grow the root filesystem to fill the card, once, on first boot
After=gadget.service local-fs.target
ConditionPathExists=!/var/lib/beamer/grown

OnFailure=beamer-led-error.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/growfs.sh

[Install]
WantedBy=multi-user.target
