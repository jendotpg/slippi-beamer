[Unit]
Description=Check gadget status, detect a game in progress, publish finished replays
After=gadget.service
BindsTo=gadget.service
ConditionPathExists=/srv/gadget.img

# Deliberately no OnFailure=beamer-led-error.service - status-check.sh already 
# trips the LED through beamer_error on the paths that exit non-zero.

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/status-check.sh
